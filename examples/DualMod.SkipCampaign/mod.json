{
  "id": "skip-campaign",
  "name": "Skip Campaign",
  "description": "Adds an opt-in Skip Campaign toggle to PoE 3.29 character creation (LeagueOverlay cards and CreateCharacter bar) so eligible characters spawn directly in Karui Shores with campaign quest flags, Kitava resistance penalties, waypoints, refund points, and Lab ascendancy trials applied.",
  "author": "LocalExile Community",
  "version": "1.0.0",
  "compatibleClientVersions": [
    "0.5.2-beta"
  ],
  "kind": "feature",
  "depends": [
    "Game"
  ],
  "assembly": "skip-campaign.dll",
  "enabled": true,
  "nativeClient": {
    "required": false,
    "sdkVersionRange": ">=0.3.0 <2.0.0",
    "supportedBuilds": [
      "3.29.3d",
      "3.29.3c"
    ],
    "assembly": "skip-campaign.Client.dll",
    "payloadDir": "client",
    "overlays": [
      "Metadata/UI/Mods/skip-campaign/CreateCharacterSkipBar.ui"
    ],
    "replaces": [],
    "rawAccess": false,
    "customOpcodes": [],
    "gealBuiltins": [],
    "customControls": [],
    "contentRegistries": [],
    "serverHalf": {
      "id": "skip-campaign",
      "minVersion": "1.0.0",
      "supportsGracefulFallback": true,
      "channelName": "skip-campaign"
    }
  }
}
