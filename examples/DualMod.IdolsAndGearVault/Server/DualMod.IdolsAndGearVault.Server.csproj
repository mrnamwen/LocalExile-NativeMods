    <None Include="IdolsVaultLocalExileEntry.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\DualMod.IdolsAndGearVault.Shared.csproj" />
    <ProjectReference Include="..\..\..\src\LocalExile.Client.ServerBridge\LocalExile.Client.ServerBridge.csproj" />
  </ItemGroup>
</Project>
