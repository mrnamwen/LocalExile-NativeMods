<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DualMod.IdolsAndGearVault.Server</RootNamespace>
    <AssemblyName>idolsvault</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- IdolsVaultLocalExileEntry.cs is a ready-to-drop LocalExile Gateway IMod entry point compiled
         by LocalExile's ModHost Roslyn loader against the live Gateway assemblies in Mods/Binaries/idolsvault/. -->
