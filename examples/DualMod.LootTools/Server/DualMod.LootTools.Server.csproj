<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DualMod.LootTools.Server</RootNamespace>
    <AssemblyName>loottools</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- LootToolsLocalExileEntry.cs is a ready-to-drop LocalExile Gateway IMod entry point compiled
         by LocalExile's ModHost Roslyn loader against the live Gateway assemblies in Mods/Binaries/loottools/. -->
    <Compile Remove="LootToolsLocalExileEntry.cs" />
    <None Include="LootToolsLocalExileEntry.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\DualMod.LootTools.Shared.csproj" />
    <ProjectReference Include="..\..\..\src\LocalExile.Client.ServerBridge\LocalExile.Client.ServerBridge.csproj" />
  </ItemGroup>
</Project>
