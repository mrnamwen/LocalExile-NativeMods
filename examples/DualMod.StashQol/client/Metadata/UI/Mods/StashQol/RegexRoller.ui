// Stash & Inventory QoL — Native 3.29.3d Regex Roller Dialog.
// Uses stock 3.29.3d controls (Frame, StackLayout, Label, TextBox, CheckBox, BasicButton)
// with explicit unique IDs and zero UiLayoutLinter diagnostics.

<DEFINITIONS>

const $w = 680;
const $pad = 24;
const $inner = 632;

begin Frame
	id = stashqol_regex_roller;
	aspect_mode = scaley;
	size = $w, 470;
	min_size = $w, 420;
	auto_size = false, true;
	float = centre;
	y = 140;
	visible = true;
	mouse_enabled = true;
	propagate_properties = false;

	background_colour = argb( 236, 12, 13, 18 );
	pixel_border_colour = rgb( 137, 100, 64 );

	begin StackLayout
		id = body;
		auto_size = true, true;
		margin = $pad, 16, $pad, 18;
		float = centre;

		begin Frame
			id = title_bar;
			size = $inner, 44;
			margin = 0, 0, 0, 8;

			begin Label
				id = title_label;
				location = 44, 0;
				size = $inner - 88, 44;
				auto_size = false;
				text_align = MiddleCentre;
				font = Fonts.LargeSC;
				foreground_colour = rgb( 227, 194, 146 );
				outline_colour = rgb( 0, 0, 0 );
				text = "Regex Item Roller";
			end

			begin BasicButton
				id = close_button;
				location = $inner - 41, 2;
				size = 41, 41;
				mouse_enabled = true;
				background = "Art/2DArt/UIImages/Common/ButtonCloseNormal", stretch;
			end
		end

		begin Frame
			id = header_divider;
			float = centre;
			background = "Art/2DArt/UIImages/InGame/Divider", stretch;
			size = $inner - 24, 8;
			margin = 0, 0, 0, 10;
		end

		begin Frame
			id = target_box;
			size = $inner, 64;
			margin = 0, 0, 0, 10;
			background_colour = argb( 210, 18, 20, 28 );
			pixel_border_colour = rgb( 98, 78, 56 );

			begin Label
				id = target_preview_label;
				location = 12, 6;
				size = $inner - 170, 26;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.Normal;
				foreground_colour = rgb( 255, 232, 150 );
				text = "Target: Hover an item and click Capture";
			end

			begin Label
				id = orb_type_label;
				location = 12, 34;
				size = $inner - 170, 24;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.SmallNormal;
				foreground_colour = rgb( 180, 196, 212 );
				text = "Currency: Chaos Orb";
			end

			begin BasicButton
				id = capture_hover_button;
				location = $inner - 148, 12;
				size = 136, 40;
				mouse_enabled = true;
				background_colour = argb( 225, 42, 34, 24 );
				pixel_border_colour = rgb( 168, 132, 82 );

				begin Label
					id = capture_hover_label;
					location = 0, 0;
					size = 136, 40;
					auto_size = false;
					text_align = MiddleCentre;
					font = Fonts.SmallNormalSC;
					foreground_colour = rgb( 235, 212, 168 );
					mouse_enabled = false;
					text = "Capture Hover";
				end
			end
		end

		begin Frame
			id = pattern_row;
			size = $inner, 70;
			margin = 0, 0, 0, 10;

			begin Label
				id = pattern_caption;
				location = 0, 0;
				size = $inner, 24;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.SmallNormalSC;
				foreground_colour = rgb( 227, 194, 146 );
				text = "Regex Pattern";
			end

			begin TextBox
				id = pattern_textbox;
				location = 0, 28;
				size = $inner, 38;
				max_length = 256;
				font = Fonts.Normal;
				foreground_colour = rgb( 245, 245, 245 );
				background_colour = argb( 230, 8, 9, 13 );
				pixel_border_colour = rgb( 120, 96, 68 );
				text = "";
			end
		end

		begin Frame
			id = options_row;
			size = $inner, 74;
			margin = 0, 0, 0, 10;

			begin Label
				id = max_rolls_caption;
				location = 0, 0;
				size = 180, 24;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.SmallNormalSC;
				foreground_colour = rgb( 227, 194, 146 );
				text = "Max Rolls (1-2000)";
			end

			begin TextBox
				id = max_rolls_textbox;
				location = 0, 28;
				size = 160, 38;
				max_length = 6;
				font = Fonts.Normal;
				foreground_colour = rgb( 245, 245, 245 );
				background_colour = argb( 230, 8, 9, 13 );
				pixel_border_colour = rgb( 120, 96, 68 );
				text = "200";
			end

			begin CheckBox
				id = case_insensitive_checkbox;
				location = 188, 30;
				size = 210, 34;
				checked = true;
				text = "Ignore Case";
			end

			begin CheckBox
				id = match_all_lines_checkbox;
				location = 412, 30;
				size = 220, 34;
				checked = false;
				text = "Match Full Card";
			end
		end

		begin Frame
			id = action_bar;
			size = $inner, 46;
			margin = 0, 4, 0, 8;

			begin BasicButton
				id = roll_button;
				location = 0, 0;
				size = 300, 44;
				mouse_enabled = true;
				background_colour = argb( 235, 36, 72, 46 );
				pixel_border_colour = rgb( 120, 200, 140 );

				begin Label
					id = roll_button_label;
					location = 0, 0;
					size = 300, 44;
					auto_size = false;
					text_align = MiddleCentre;
					font = Fonts.NormalSC;
					foreground_colour = rgb( 235, 255, 235 );
					mouse_enabled = false;
					text = "Roll Until Match";
				end
			end

			begin BasicButton
				id = cancel_button;
				location = 332, 0;
				size = 300, 44;
				mouse_enabled = true;
				background_colour = argb( 230, 62, 28, 28 );
				pixel_border_colour = rgb( 170, 96, 86 );

				begin Label
					id = cancel_button_label;
					location = 0, 0;
					size = 300, 44;
					auto_size = false;
					text_align = MiddleCentre;
					font = Fonts.NormalSC;
					foreground_colour = rgb( 245, 220, 215 );
					mouse_enabled = false;
					text = "Close";
				end
			end
		end

		begin Label
			id = status_label;
			size = $inner, 32;
			auto_size = false;
			text_align = MiddleLeft;
			font = Fonts.SmallNormal;
			foreground_colour = rgb( 196, 204, 216 );
			text = "Ready. Hover any craftable item or click Capture Hover.";
		end
	end
end
