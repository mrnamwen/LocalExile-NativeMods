<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DualMod.MaxwellPet.Client</RootNamespace>
    <AssemblyName>maxwell.Client</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile Shared/ message records directly into maxwell.Client.dll so ClientModLoader
         loads it as a single self-contained assembly inside a collectible AssemblyLoadContext. -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\src\LocalExile.Client.Sdk\LocalExile.Client.Sdk.csproj" />
  </ItemGroup>
</Project>
