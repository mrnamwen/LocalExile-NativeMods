// Orb of Siphoning — Authentic Path of Exile 3.29.3d Recombinator-style Item-Card Modifier Selector.
// Verified 3.29.3d UI rules:
// - Leading comment before <DEFINITIONS>
// - 100% stock registered 3.29.3d control types (Frame, StackLayout, Label, Picture, BasicButton, Button)
// - Every ancestor container carries an explicit unique id (case-sensitive FindChild)
// - Spacer Frame after Picture inside StackLayout (never puts margin on Picture inside StackLayout)
// - Full-width clickable modifier rows use BasicButton (+0x2A0 click event) with mouse_enabled = false
//   on all overlaid Picture/Frame/Label children so clicking anywhere on a modifier line triggers Clicked
// - Real 3.29.3d Kingsmarch Recombinator 9-slice frame, Rare/Magic item card headers & separators,
//   CraftingBench modifier selection bars, circular close button, and Orb of Siphoning DDS icons

<DEFINITIONS>

const $w = 960;
const $pad = 28;
const $inner = 904;
const $card_w = 904;
const $card_inner = 872;
const $row_h = 52;

begin Frame
	id = siphon_picker_window;
	aspect_mode = scaley;
	size = $w, 760;
	min_size = $w, 420;
	auto_size = true, true;
	float = centre;
	y = 140;
	visible = true;
	mouse_enabled = true;
	propagate_properties = false;

	border = normal,
		"Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageCraftTopLeft", "Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageCraftTop", "Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageCraftTopRight",
		"Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageCraftLeft", "Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageCraftRight",
		"Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageCraftBottomLeft", "Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageCraftBottom", "Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageCraftBottomRight";
	border_position = outside;
	background = "Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageCraftingBorderCentre", tile;

	begin StackLayout
		id = body;
		auto_size = true, true;
		margin = $pad, 18, $pad, 18;
		float = centre;

		begin Frame
			id = title_bar;
			size = $inner, 46;
			margin = 0, 0, 0, 6;

			begin Label
				id = title_label;
				location = 48, 0;
				size = $inner - 96, 46;
				auto_size = false;
				text_align = MiddleCentre;
				font = Fonts.LargeSC;
				foreground_colour = rgb( 227, 194, 146 );
				outline_colour = rgb( 0, 0, 0 );
				text = "Orb of Siphoning";
			end

			begin BasicButton
				id = close_button;
				location = $inner - 42, 2;
				size = 41, 41;
				mouse_enabled = true;
				background = "Art/2DArt/UIImages/Common/ButtonCloseNormal", stretch;
			end
		end

		begin Picture
			id = header_divider;
			float = centre;
			source = "Art/2DArt/UIImages/InGame/Divider";
			size = $inner - 40, 8;
		end

		begin Frame
			id = header_spacer;
			size = 10, 10;
		end

		begin Frame
			id = steal_orb_box;
			size = $inner, 84;
			float = centre;
			margin = 0, 0, 0, 12;
			background_colour = argb( 215, 10, 12, 16 );
			pixel_border_colour = rgb( 137, 100, 64 );
			visible = true;

			begin Frame
				id = steal_orb_icon_frame;
				location = 14, 7;
				size = 70, 70;
				background = "Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/VillageResourceSlot", stretch;
				mouse_enabled = false;

				begin Picture
					id = steal_orb_icon;
					location = 4, 4;
					size = 62, 62;
					source = "Art/2DItems/Currency/Mods/Siphon/SiphonOrbEmpty.dds";
					mouse_enabled = false;
				end
			end

			begin Label
				id = steal_mode_header;
				location = 98, 10;
				size = $inner - 114, 28;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.NormalSC;
				foreground_colour = rgb( 227, 194, 146 );
				outline_colour = rgb( 0, 0, 0 );
				text = "CLICK A MODIFIER ON THE ITEM CARD TO SIPHON";
			end

			begin Label
				id = subtitle_label;
				location = 98, 40;
				size = $inner - 114, 34;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.SmallNormal;
				foreground_colour = rgb( 205, 205, 195 );
				text = "Extracts the chosen explicit modifier into a Charged Orb of Siphoning.";
			end
		end

		begin Frame
			id = stored_mod_box;
			size = $inner, 96;
			float = centre;
			margin = 0, 0, 0, 12;
			background_colour = argb( 228, 10, 18, 28 );
			pixel_border_colour = rgb( 95, 205, 245 );
			visible = false;

			begin Frame
				id = charged_orb_icon_frame;
				location = 14, 10;
				size = 76, 76;
				background = "Art/2DArt/UIImages/InGame/Village/RecombinateCrafting/ThaumaturgicDustDisplay", stretch;
				mouse_enabled = false;

				begin Picture
					id = charged_orb_icon;
					location = 6, 6;
					size = 64, 64;
					source = "Art/2DItems/Currency/Mods/Siphon/SiphonOrbCharged.dds";
					mouse_enabled = false;
				end
			end

			begin Label
				id = stored_mod_title;
				location = 104, 8;
				size = $inner - 120, 26;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.SmallNormalSC;
				foreground_colour = rgb( 130, 225, 255 );
				outline_colour = rgb( 0, 0, 0 );
				text = "IMBUE INTO TARGET ITEM — STORED MODIFIER";
			end

			begin Label
				id = stored_mod_label;
				location = 104, 35;
				size = $inner - 120, 32;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.Normal;
				foreground_colour = rgb( 255, 232, 150 );
				outline_colour = rgb( 0, 0, 0 );
				text = "(None)";
			end

			begin Label
				id = stored_mod_hint;
				location = 104, 67;
				size = $inner - 120, 24;
				auto_size = false;
				text_align = MiddleLeft;
				font = Fonts.Small;
				foreground_colour = rgb( 178, 192, 205 );
				text = "Click a compatible modifier on the target item card below to replace it.";
			end
		end

		begin Frame
			id = item_card_frame;
			size = $card_w, 420;
			auto_size = false, true;
			float = centre;
			margin = 0, 0, 0, 12;
			background_colour = argb( 244, 6, 6, 8 );
			pixel_border_colour = rgb( 137, 100, 64 );

			begin StackLayout
				id = item_card_body;
				width = $card_w;
				auto_size = false, true;

				begin Frame
					id = item_header_rare;
					size = $card_w, 88;
					visible = true;

					begin Picture
						id = rare_hdr_left;
						location = 0, 0;
						size = 71, 88;
						source = "Art/2DArt/UIImages/InGame/ItemsHeaderRareLeft";
						mouse_enabled = false;
					end

					begin Picture
						id = rare_hdr_mid;
						location = 71, 0;
						size = $card_w - 142, 88;
						source = "Art/2DArt/UIImages/InGame/ItemsHeaderRareMiddle";
						mouse_enabled = false;
					end

					begin Picture
						id = rare_hdr_right;
						location = $card_w - 71, 0;
						size = 71, 88;
						source = "Art/2DArt/UIImages/InGame/ItemsHeaderRareRight";
						mouse_enabled = false;
