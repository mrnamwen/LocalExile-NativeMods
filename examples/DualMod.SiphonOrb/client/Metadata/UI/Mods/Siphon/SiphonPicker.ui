								text_align = MiddleCentre;
								font = Fonts.Normal;
								foreground_colour = rgb( 136, 136, 255 );
								outline_colour = rgb( 0, 0, 0 );
								mouse_enabled = false;
								text = "Modifier 5";
							end

							begin Label
								id = affix_state_4;
								location = $card_inner - 152, 0;
								size = 140, $row_h;
								auto_size = false;
								text_align = MiddleRight;
								font = Fonts.SmallSC;
								foreground_colour = rgb( 125, 225, 255 );
								outline_colour = rgb( 0, 0, 0 );
								mouse_enabled = false;
								text = "";
							end
						end
					end

					begin Frame
						id = affix_row_5;
						size = $card_inner, $row_h;
						margin = 0, 0, 0, 6;

						begin BasicButton
							id = affix_btn_5;
							location = 0, 0;
							size = $card_inner, $row_h;
							mouse_enabled = true;
							background = "Art/2DArt/UIImages/InGame/CraftingWindow/MasterCraftingLesserRecipeDefault", stretch;
							pixel_border_colour = argb( 155, 76, 64, 48 );

							begin Picture
								id = affix_sel_bg_5;
								location = 0, 0;
								size = $card_inner, $row_h;
								source = "Art/2DArt/UIImages/InGame/CraftingWindow/MasterCraftingLesserRecipeSelected";
								mouse_enabled = false;
								visible = false;
							end

							begin Frame
								id = affix_sel_border_5;
								location = 0, 0;
								size = $card_inner, $row_h;
								pixel_border_colour = rgb( 110, 220, 255 );
								mouse_enabled = false;
								visible = false;
							end

							begin Frame
								id = affix_lock_bg_5;
								location = 0, 0;
								size = $card_inner, $row_h;
								background_colour = argb( 185, 10, 10, 14 );
								pixel_border_colour = argb( 130, 125, 54, 54 );
								mouse_enabled = false;
								visible = false;
							end

							begin Label
								id = affix_tag_5;
								location = 14, 0;
								size = 118, $row_h;
								auto_size = false;
								text_align = MiddleLeft;
								font = Fonts.SmallSC;
								foreground_colour = rgb( 212, 180, 120 );
								outline_colour = rgb( 0, 0, 0 );
								mouse_enabled = false;
								text = "SUFFIX";
							end

							begin Label
								id = affix_label_5;
								location = 134, 0;
								size = $card_inner - 290, $row_h;
								auto_size = false;
								text_align = MiddleCentre;
								font = Fonts.Normal;
								foreground_colour = rgb( 136, 136, 255 );
								outline_colour = rgb( 0, 0, 0 );
								mouse_enabled = false;
								text = "Modifier 6";
							end

							begin Label
								id = affix_state_5;
								location = $card_inner - 152, 0;
								size = 140, $row_h;
								auto_size = false;
								text_align = MiddleRight;
								font = Fonts.SmallSC;
								foreground_colour = rgb( 125, 225, 255 );
								outline_colour = rgb( 0, 0, 0 );
								mouse_enabled = false;
								text = "";
							end
						end
					end
				end
			end
		end

		begin Label
			id = status_label;
			width = $inner;
			auto_size = true;
			float = centre;
			text_align = MiddleCentre;
			font = Fonts.SmallNormal;
			foreground_colour = rgb( 235, 225, 200 );
			outline_colour = rgb( 0, 0, 0 );
			text = "Click a modifier on the item card, then confirm.";
			margin = 0, 2, 0, 10;
		end

		begin Picture
			id = footer_divider;
			float = centre;
			source = "Art/2DArt/UIImages/InGame/Divider";
			size = $inner - 40, 8;
		end

		begin Frame
			id = footer_spacer;
			size = 10, 12;
		end

		begin Frame
			id = action_row;
			size = 560, Sizes[ "Button" ].Size.Height;
			float = centre;
			propagate_properties = false;

			begin Button
				id = confirm_button;
				size = 280, Sizes[ "Button" ].Size.Height;
				float = inside left, 0;
				text = "Siphon Modifier";
			end

			begin Button
				id = cancel_button;
				size = 220, Sizes[ "Button" ].Size.Height;
				float = inside right, 0;
				text = "Cancel";
			end
		end
	end
end
